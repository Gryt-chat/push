PORT=8080
DATA_DIR=./data

# Behind Cloudflare or another proxy. Name the proxy's address in TRUSTED_PROXIES
# so a client cannot pick its own rate-limit bucket with a forged header.
TRUST_PROXY=false
TRUSTED_PROXIES=

# iOS. An APNs auth key (.p8) from developer.apple.com, team 8883W2XTQ8.
# APNS_KEY takes the PEM inline with \n for newlines; APNS_KEY_PATH reads a file.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=8883W2XTQ8
APNS_TOPIC=chat.gryt.app

# Android. A Firebase service account JSON with the Cloud Messaging role.
FCM_SERVICE_ACCOUNT_PATH=

LIMIT_REGISTRATIONS_PER_HOUR_PER_IP=60
LIMIT_PUSHES_PER_MINUTE_PER_DEVICE=20
LIMIT_PUSHES_PER_MINUTE_PER_IP=1200
IDLE_DAYS=120
